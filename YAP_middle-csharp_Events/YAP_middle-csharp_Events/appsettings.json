{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=events;Username=postgres;Password=DATABASE_PASSWORD_FROM_USERSECRETS",
    "Redis": "localhost:6379"
  },

  "EventCache": {
    "DefaultTTL": "00:10:00",
    "Top10EventsTTL": "00:02:00"
  },

  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },

    "AllowedHosts": "*",

    "JwtSettings": {
      "Issuer": "YAP_AuthService",
      "Audience": "YAP_Microservices",
      "SecretKey": "KEY_FROM_USERSECRETS"
    }
  }
