{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=EventApi;Username=postgres;Password=DATABASE_PASSWORD_FROM_USERSECRETS"
  },

  "AllowedHosts": "*",

  "JwtSettings": {
    "Issuer": "YAP_AuthService",
    "Audience": "YAP_Microservices",
    "SecretKey": "KEY_FROM_USERSECRETS"
  },

  "Services": {
    "EventsUrl": "http://localhost:5002"
  },

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5001"
      }
    }
  },

  "Kafka": {
    "BootstrapServers": "localhost:9092"
  }
}
