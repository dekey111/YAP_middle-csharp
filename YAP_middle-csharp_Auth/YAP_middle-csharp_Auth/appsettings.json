{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=users;Username=postgres;Password=DATABASE_PASSWORD_FROM_USERSECRETS"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },

  "JwtSettings": {
    "Issuer": "YAP_AuthService",
    "Audience": "YAP_Microservices",
    "ExpiryMinutes": 60,
    "SecretKey": "KEY_FROM_USERSECRETS"
  }
}
